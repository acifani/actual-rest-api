{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "outDir": "dist",
        "lib": [
            "es2025",
            "ESNext.Collection",
            "ESNext.Temporal"
        ],
        "module": "nodenext",
        "target": "es2025",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmit": true,
        "rewriteRelativeImportExtensions": true,
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true
    }
}
